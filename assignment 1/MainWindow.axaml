<Window xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="ImageApp.MainWindow"
	Width="1000" Height="650"
	MinWidth="800" MinHeight="500"
	Title="Image Processing Assignment">

	<Grid RowDefinitions="*, Auto, Auto, Auto" Margin="10">
		<!-- Side-by-side images -->
		<Grid Grid.Row="0" ColumnDefinitions="*,*" Margin="0,0,0,10">
			<!-- Original Image Container -->
			<Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,5,0">
				<TextBlock Text="Original Image" FontWeight="SemiBold" Margin="2,0,0,4"/>
				<Border Grid.Row="1"
					BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
					BorderThickness="1"
					CornerRadius="4"
					Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
					ClipToBounds="True">
				<Image x:Name="OriginalImage" Stretch="Uniform" Margin="4"/>
				</Border>
			</Grid>

			<!-- Processed Image Container -->
			<Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="5,0,0,0">
				<TextBlock Text="Processed Image" FontWeight="SemiBold" Margin="2,0,0,4"/>
					<Border Grid.Row="1"
						BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
						BorderThickness="1"
						CornerRadius="4"
						Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
						ClipToBounds="True">
					<Image x:Name="ProcessedImage" Stretch="Uniform" Margin="4"/>
				</Border>
			</Grid>
		</Grid>

		<!-- Controls: Load, Save, Dropdown, Apply -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
			<Button Content="Load Image" Width="110" Click="OnLoadImage"/>
			<Button Content="Save Image" Width="110" Click="OnSaveImage"/>
			<ComboBox x:Name="OperationBox" Width="240"/>
			<Button x:Name="ApplyButton" Content="Apply" Width="100" Click="OnApply"/>
			<Button x:Name="TogglePixelArtButton" Content="Toggle Filtering" Width="150" Click="OnToggledPixelArt"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Vertical" Spacing="10" Margin="0,0,0,4">
		<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
			<TextBlock Text="Smoothing Method"/>
			<ComboBox x:Name="SmoothingMethodSelector" SelectedIndex="0" MaxDropDownHeight="100">
				<ComboBoxItem>Gaussian</ComboBoxItem>
				<ComboBoxItem>Median</ComboBoxItem>
			</ComboBox>
			<TextBlock Text="Kernel Size"/>
			<NumericUpDown x:Name="KernelSize" Minimum="0" Maximum="100" Increment="1" Value="4" ShowButtonSpinner="False" />
			<TextBlock Text="Gaussian Sigma"/>
			<NumericUpDown x:Name="GaussianSigma" Minimum="0" Maximum="100" Increment="1" Value="5" ShowButtonSpinner="False"/>
			<TextBlock Text="Threshold"/>
			<NumericUpDown x:Name="Threshold" Minimum="0" Maximum="255" Increment="1" Value="128" ShowButtonSpinner="False"/>
			<TextBlock Text="Structuring Element Size"/>
			<NumericUpDown x:Name="StructureSize" Minimum="0" Maximum="100" Increment="1" Value="3" ShowButtonSpinner="False" />
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
			<TextBlock Text="Hysteresis% Low"/>
			<NumericUpDown x:Name="HysteresisLow" Minimum="0" Maximum="1" Increment="1" Value="0.05" ShowButtonSpinner="False" />
			<TextBlock Text="Hysteresis% High"/>
			<NumericUpDown x:Name="HysteresisHigh" Minimum="0" Maximum="1" Increment="1" Value="0.2" ShowButtonSpinner="False" />
		</StackPanel>
		</StackPanel>

		<TextBlock Grid.Row="3" x:Name="StatusText" Text="" TextWrapping="Wrap" Margin="0,4,0,0"/>
	</Grid>
</Window>
